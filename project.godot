; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dark Nova Rogue Squadron"
config/description="A fake operating system interface, created by popcar2 for fun!"
config/version="1.2.0"
run/main_scene="res://Scenes/Main/MainScene.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GodotOS"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://Art/Godot Logo.png"
config/icon="res://icon.svg"

[autoload]

HotkeyManager="*res://Scenes/Autoloads/Hotkey Manager/hotkey_manager.tscn"
ContextMenu="*res://Scenes/Autoloads/Context Menu/context_menu.tscn"
NotificationManager="*res://Scenes/Autoloads/Notification Manager/notification_manager.tscn"
CopyPasteManager="*res://Scenes/Autoloads/CopyPaste Manager/copy_paste_manager.tscn"
GlobalValues="*res://Scenes/Autoloads/GlobalValues/global_values.tscn"
DefaultValues="*res://Scenes/Autoloads/Default Values/default_values.tscn"
NetworkManager="*res://Scenes/Networking/network_manager.tscn"
SpaceWorldManager="*res://Outside/space_world_manager.gd"
StarSystemGridManager="*res://Outside/StarSystemGrid/star_system_grid_manager.gd"
ShipDriveManager="*res://Scenes/Autoloads/ShipDrive/ship_drive_manager.gd"
RemoteDriveManager="*res://Scenes/Autoloads/ShipDrive/remote_drive_manager.gd"
TerminalDriveManager="*res://Scenes/Autoloads/TerminalDrive/terminal_drive_manager.gd"
FolderPasswordManager="*res://Scenes/Autoloads/FolderPasswordManager/folder_password_manager.gd"
ShipSoftwareManager="*res://Scenes/Autoloads/SoftwareManager/ship_software_manager.gd"
TerminalSoftwareManager="*res://Scenes/Autoloads/SoftwareManager/terminal_software_manager.gd"
CargoManager="*res://Economy/cargo_manager.gd"
FluxEconomyManager="*res://Economy/flux_economy_manager.gd"
RoomDatabase="*res://Scenes/Autoloads/RoomDatabase.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/ship_sublayer_editor/plugin.cfg", "res://addons/star_system_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://Applications/": "orange",
"res://Applications/Games/": "red",
"res://Art/": "green",
"res://Default Files/": "gray",
"res://Outside/": "purple",
"res://Scenes/": "blue",
"res://Scenes/Misc/": "gray"
}

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[gui]

theme/default_font_hinting=2
theme/lcd_subpixel_layout=0

