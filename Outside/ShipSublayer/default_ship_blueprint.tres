[sub_resource type="Resource" id="Resource_3i4yk"]
script = ExtResource("2_2o3qs")
path = "Ship Drive/Programs/Comms/comms_config.dat"
content = "# DARK NOVA COMMUNICATIONS & EW RUNTIME CONFIGURATION
# WARNING: SUBSPACE TRANSCEIVER & HACKWARFARE PROTOCOLS
[SYSTEM]
app_name=Comms
version=1.0.4
status=OPERATIONAL
subspace_relay_active=true

[FREQUENCY]
default_freq_mhz=1420.0
bandwidth_hz=1420.0
signal_amplification=1.2
signal_noise_ratio=0.85
auto_tune_sos=true

[ELECTRONIC_WARFARE]
jamming_power_mw=120.0
jamming_radius=15000.0
spoofing_signature=CORVETTE_CIVILIAN
overclock_ew_boost=1.0
"
is_protected = true
desc = "Configurazione ricetrasmettitore subspaziale e moduli di disturbo EW."

[sub_resource type="Resource" id="Resource_mbylt"]
script = ExtResource("2_2o3qs")
path = "Ship Drive/Programs/Comms/crypto_tuning.dat"
content = "# CRYPTO ANALYSIS & DECRYPTION CALIBRATION MATRIX
