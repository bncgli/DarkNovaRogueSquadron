crypto_crack_speed=1.0
matrix_layers=3
auto_archive_decrypted=true
"
is_protected = true
desc = "Parametri decodifica cifrari e velocità crittanalisi."

[sub_resource type="Resource" id="Resource_gvkt0"]
script = ExtResource("2_2o3qs")
path = "Ship Drive/Programs/DuctDrone/duct_drone_config.dat"
content = "# DARK NOVA DUCT DRONE RUNTIME CONFIGURATION
# WARNING: SYSTEM CONFIGURATION FILE - MAINTENANCE & REPAIR ROBOT
[SYSTEM]
app_name=DuctDrone
version=1.0.4
status=OPERATIONAL
maintenance_subsystem=ACTIVE

[DRONE_DYNAMICS]
linear_speed=175.0
linear_acceleration=650.0
linear_deceleration=750.0
rotate_speed=3.0

[BATTERY_MANAGEMENT]
battery_max=100.0
battery_drain_move=0.35
battery_drain_lights=0.75
battery_drain_radar=3.5
battery_drain_repair=6.0

[MAINTENANCE]
radar_scan_radius_max=160.0
repair_range=42.0
repair_speed_multiplier=1.0
"
is_protected = true
desc = "Configurazione dinamica e gestione energetica del drone di manutenzione."

