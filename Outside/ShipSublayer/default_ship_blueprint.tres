drive_files = Array[Dictionary]([{
"content": "=== DARK NOVA - SISTEMI NAVE ===
Reattore Principale: ONLINE (100% Efficienza)
Propulsione Sub-Luce: ATTIVA
Scudi Deflettori: OPERATIVI
Array Sensori & Cams: 6 Canali Attivi (Prua, Poppa, Babordo, Tribordo, Dorsale, Ventrale)
Sottosistemi di Guida: Calibrati
",
"desc": "Riepilogo stato dei sistemi e della telemetria di bordo.",
"is_protected": false,
"path": "Ship Drive/Ship Systems.txt"
}, {
"content": "=== REGISTRO DI BORDO ===
[STARDATE 7815.4] Connessione al sistema centrale stabilita.
Tutti i sistemi della Dark Nova sono pronti alla navigazione spaziale.
Equipaggio autorizzato ad accedere all'unita' condivisa Ship Drive.
",
"desc": "Registro eventi e cronologia di navigazione.",
"is_protected": false,
"path": "Ship Drive/Flight Log.txt"
}, {
"content": "=== DIRETTIVE EQUIPAGGIO ===
1. Mantenere monitorati i feed video delle telecamere esterne durante la navigazione.
2. Coordinare le manovre di volo e la spinta propulsori con la plancia.
3. Condividere report di missione e file di rotta all'interno dello Ship Drive.
",
"desc": "Protocolli operativi per l'equipaggio in missione.",
"is_protected": false,
"path": "Ship Drive/Crew Directives.txt"
}, {
"content": "# DARK NOVA FLIGHT CONTROLS RUNTIME CONFIGURATION
# WARNING: SYSTEM CONFIGURATION FILE - ACTIVE FLIGHT TUNING
[SYSTEM]
app_name=FlightControls
version=1.0.4
status=OPERATIONAL
rcs_subsystem=ACTIVE

[FLIGHT_DYNAMICS]
max_linear_speed=20.0
linear_acceleration=35.0
linear_deceleration=20.0
max_angular_speed=2.5
angular_acceleration=8.0
angular_deceleration=6.0

[SPEED_MODES]
turbo_multiplier=2.0
precision_multiplier=0.4
",
"desc": "Parametri di dinamica e limiti di manovra del sistema di volo.",
"is_protected": true,
"path": "Ship Drive/Programs/FlightControls/flight_config.dat"
}, {
"content": "# RCS & MAIN THRUSTERS TUNING MATRIX
