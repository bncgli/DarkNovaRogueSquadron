[gd_resource type="Resource" script_class="AppResource" format=3]

[ext_resource type="Script" path="res://Scenes/Autoloads/SoftwareManager/app_resource.gd" id="1_shres"]
[ext_resource type="Texture2D" path="res://Art/Icons/Apps/station_hub.svg" id="1_icon"]

[resource]
script = ExtResource("1_shres")
icon = ExtResource("1_icon")
roles = Array[String](["Captain", "Engineer", "Hacker", "Pilot", "Stagista", "Capitano", "Ingegnere", "Pilota"])
power_draw_mw = 40.0
required_subsystems = Array[String](["comms", "navigation"])
app_id = "station_hub"
title = "Hub Servizi Portuali"
description = "Interfaccia diegetica servizi di stazione: Cantiere, Mercato Firmware, Bacheca Contratti e Taverna."
developer = "Pulse Networks"
category = "Sistemi Nave"
menu_path = "Strumenti"
icon_color = Color(0.2, 0.8, 0.7, 1)
scene_path = "res://Applications/StationHub/station_hub_app.tscn"
default_window_size = Vector2(780, 560)
drive_folder = "Programs/StationHub"
default_password = "STTN-7815"
default_files = Array[Dictionary]([{
"content": "[SYSTEM]
app_name=StationHubApp
version=1.0.0
status=OPERATIONAL

[SERVICES]
auto_handshake=true
default_credits=5000
allow_firmware_trade=true
logbook_sync=true
",
"desc": "Configurazione docking suite, crediti e autorizzazioni servizi portuali.",
"is_protected": true,
"path": "Ship Drive/Programs/StationHub/station_hub_config.dat"
}])
