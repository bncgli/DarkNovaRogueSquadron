"content": "# DARK NOVA POWER GRID RUNTIME CONFIGURATION
# WARNING: ELECTRICAL GRID AND POWER DISTRIBUTION MATRIX
[SYSTEM]
app_name=PowerGrid
version=1.0.4
status=OPERATIONAL
mode=AUTOMATIC_BALANCING
decryption_key=GRID-CFG-7815

[GRID_SETTINGS]
reactor_output_mw=1200.0
aux_generator_mw=450.0
junction_switch_delay=0.25
overload_threshold_pct=110.0
reroute_efficiency_loss=0.05

[CIRCUIT_PROTECTION]
breaker_trip_threshold=1.4
short_circuit_damping=0.85
auto_reroute_on_short=false
",
"desc": "Configurazione reattore, soglie di sovraccarico e disgiuntori della rete.",
"is_protected": true,
"path": "Ship Drive/Programs/PowerGrid/power_grid_config.dat"
}, {
