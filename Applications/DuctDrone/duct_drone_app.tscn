theme_override_font_sizes/font_size = 10
text = "Guida Comandi Tank:
• W / ▲: Avanza verso prua
• S / ▼: Retromarcia
• A / ◄: Ruota prua a SX
• D / ►: Ruota prua a DX
• E: Ripara danno adiacente
• F: Toggle Fari (Luce)
• Radar / R: Impulso sonar
• Spazio / X: Stop rapido"
autowrap_mode = 2

