selection_enabled = true

[node name="ChatInputBox" type="HBoxContainer" parent="Margin/LobbyRoomView/MainContent/RightCol"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChatInput" type="LineEdit" parent="Margin/LobbyRoomView/MainContent/RightCol/ChatInputBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Digita un messaggio per l'equipaggio..."

[node name="SendChatButton" type="Button" parent="Margin/LobbyRoomView/MainContent/RightCol/ChatInputBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
text = "Invia"

[node name="FooterBar" type="HBoxContainer" parent="Margin/LobbyRoomView"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ClientWaitingLabel" type="Label" parent="Margin/LobbyRoomView/FooterBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "⏳ In attesa che l'equipaggio sia pronto..."

[node name="ReadyButton" type="Button" parent="Margin/LobbyRoomView/FooterBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "✅ PRONTO"

[node name="LaunchMissionButton" type="Button" parent="Margin/LobbyRoomView/FooterBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 44)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 15
text = "🚀 AVVIA MISSIONE / DECOLLO"

