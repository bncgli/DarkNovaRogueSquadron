[gd_scene format=3]

[ext_resource type="Script" path="res://Applications/FlightControl/Componenti/cruise_control_panel.gd" id="1_cruise_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.08, 0.12, 0.18, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.45, 0.65, 0.9)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="CruiseControlPanel" type="PanelContainer"]
custom_minimum_size = Vector2(400, 200)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("1_cruise_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HeaderHBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.3, 0.85, 1, 1)
text = "PROPULSIONE DI CROCIERA (SUB-FTL)"

[node name="StatusBadge" type="Label" parent="VBox/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
text = "STANDBY"

[node name="ChargeVBox" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ChargeLabel" type="Label" parent="VBox/ChargeVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "CARICA BOBINE: 0% (0.0s / 4.0s)"

[node name="ChargeProgressBar" type="ProgressBar" parent="VBox/ChargeVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
step = 0.5

[node name="PhasesGrid" type="GridContainer" parent="VBox"]
layout_mode = 2
columns = 2

[node name="PhaseRestLabel" type="Label" parent="VBox/PhasesGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "1. QUIETE: OK (< 5.0 m/s)"

[node name="PhaseAlignLabel" type="Label" parent="VBox/PhasesGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "2. ROTTA: ALLINEATA (0.0°)"

[node name="PhasePowerLabel" type="Label" parent="VBox/PhasesGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "3. POTENZA: ATTESA (160 MW)"

[node name="PhaseBoostLabel" type="Label" parent="VBox/PhasesGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "4. BOOST: STANDBY"

[node name="TargetWaypointLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "DESTINAZIONE: VETTORE PRUA LIBERO"

[node name="SpeedMultLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "MOLTIPLICATORE: 8.0x"

[node name="AlertLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "Sistema pronto in attesa di sequenza di lancio"
autowrap_mode = 2

[node name="BtnToggleCruise" type="Button" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "INGAGGIA CRUISE MODE"
