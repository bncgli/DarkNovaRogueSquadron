default_password = "FLIGHT-7815"
default_files = Array[Dictionary]([{
"content": "# DARK NOVA FLIGHT CONTROLS RUNTIME CONFIGURATION
# WARNING: SYSTEM CONFIGURATION FILE - ACTIVE FLIGHT TUNING
[SYSTEM]
app_name=FlightControls
version=1.0.4
status=OPERATIONAL
rcs_subsystem=ACTIVE

[FLIGHT_DYNAMICS]
max_linear_speed=20.0
linear_acceleration=35.0
linear_deceleration=20.0
max_angular_speed=2.5
angular_acceleration=8.0
angular_deceleration=6.0

[SPEED_MODES]
turbo_multiplier=2.0
precision_multiplier=0.4
",
"desc": "Parametri di dinamica e limiti di manovra del sistema di volo.",
"is_protected": true,
"path": "Ship Drive/Programs/FlightControls/flight_config.dat"
}, {
"content": "# RCS & MAIN THRUSTERS TUNING MATRIX
[THRUSTERS]
rcs_power_rate=1.0
pitch_thrust_mult=1.0
yaw_thrust_mult=1.0
roll_thrust_mult=1.0
vertical_thrust_mult=1.0
overclock_limit=1.5
cruise_multiplier=8.0
warmup_time_sec=4.0
proximity_drop_distance=250.0
heat_penalty=45.0
",
"desc": "Matrice di calibrazione dei propulsori RCS e di spinta principale.",
"is_protected": true,
"path": "Ship Drive/Programs/FlightControls/thrusters_tuning.dat"
}])
