[resource]
script = ExtResource("1_logbook")
roles = Array[String](["Capitano", "Pilota", "Ingegnere", "Soldato", "Hacker", "Stagista", "Captain", "Pilot", "Engineer", "Soldier"])
power_draw_mw = 5.0
