",
"desc": "Configurazione sistema di logging eventi e telemetria scatola nera.",
"is_protected": true,
"path": "Ship Drive/Programs/Logbook/logbook_config.dat"
}, {
"content": "[SYNC]
sync_to_ship_drive=true
timestamp_format=STAR_DATE
cloud_backup=false
",
