[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Applications/Logbook/logbook_app.gd" id="1_logbook_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_overlay"]
bg_color = Color(0.04, 0.05, 0.07, 0.95)

[node name="LogbookApp" type="Control"]
custom_minimum_size = Vector2(600, 450)
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_logbook_script")

[node name="MainLayout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="HeaderBar" type="HBoxContainer" parent="MainLayout"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="MainLayout/HeaderBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.85, 0.3, 1)
text = "📜 REGISTRO DI BORDO & MISSIONI"

[node name="ReloadDatButton" type="Button" parent="MainLayout/HeaderBar"]
unique_name_in_owner = true
layout_mode = 2
text = "🔄 Ricarica .DAT"

[node name="ContentTabs" type="TabContainer" parent="MainLayout"]
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Contratti & Obiettivi" type="MarginContainer" parent="MainLayout/ContentTabs"]
